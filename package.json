    "pg": "^8.14.1",
    "next-auth": "^5.0.0-beta.29",
    "resend": "^4.0.0",
    "stripe": "^17.0.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "lucide-react": "^0.514.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.11.13",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.1.8",
