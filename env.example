# Database — auto-injected by Vercel Postgres; copy from Vercel dashboard for local dev
DATABASE_URL=postgresql://user:password@host:5432/commoncredit

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Resend — get from resend.com/api-keys
AUTH_RESEND_KEY=

# The "from" address for magic link emails (must be a verified Resend domain)
EMAIL_FROM=noreply@yourdomain.com

# Comma-separated list of emails that get admin role on sign-in
ADMIN_EMAILS=you@yourdomain.com

# Set automatically by Vercel; set manually for local dev
AUTH_URL=http://localhost:3000
